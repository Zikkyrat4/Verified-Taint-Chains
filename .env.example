# =============================================================================
# VTC Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# "openai" or "ollama"
LLM_PROVIDER=ollama

# Unified model name (works for both OpenAI and Ollama)
# Examples: gpt-4-turbo, llama3.2:latest, mistral:latest, deepseek-coder:latest
LLM_MODEL=llama3.2:latest

# OpenAI API key (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Graph Builder
# -----------------------------------------------------------------------------
# Use LLM-driven graph builder (tree-sitter AST + LLM enrichment)
USE_LLM_GRAPH_BUILDER=true

# Min confidence for LLM-inferred edges (0.0-1.0)
LLM_GRAPH_ENRICHMENT_CONFIDENCE=0.7

# -----------------------------------------------------------------------------
# Pathfinding
# -----------------------------------------------------------------------------
# Algorithm: "astar" (with semantic heuristic) or "bfs"
PATHFINDING_ALGORITHM=astar
USE_SEMANTIC_HEURISTIC=true

# Max taint chain path length
MAX_PATH_LENGTH=15

# Min confidence threshold for sources/sinks (0.0-1.0)
MIN_CONFIDENCE=0.6

# -----------------------------------------------------------------------------
# Verification
# -----------------------------------------------------------------------------
VERIFICATION_ENABLED=true

# Level: "cfg" (fast), "symbolic" (Z3), "both"
VERIFICATION_LEVEL=both

# Timeout for symbolic execution (seconds)
SYMBOLIC_TIMEOUT=60

# -----------------------------------------------------------------------------
# Project Mode
# -----------------------------------------------------------------------------
# Max concurrent LLM requests for Stage 1 extraction
MAX_CONCURRENT_FILES=4

# Max files to analyze (0 = unlimited)
MAX_FILES=0

# Debug/CI ONLY. When true, restores the old hard keyword pre-filter that
# DROPS files/functions without known security patterns before the LLM.
# This blinds the detector to 0-day patterns using unfamiliar APIs, so the
# default is false (analyze everything, security-matching code first).
VTC_FAST_PREFILTER=false

# -----------------------------------------------------------------------------
# Optional Features
# -----------------------------------------------------------------------------
# Use Joern for PDG analysis (requires Joern installation)
USE_JOERN=true
