# =============================================================================
# VTC Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# "openai" or "ollama"
LLM_PROVIDER=ollama

# Unified model name (works for both OpenAI and Ollama)
# Examples: gpt-4-turbo, llama3.2:latest, mistral:latest, deepseek-coder:latest
LLM_MODEL=llama3.2:latest

# OpenAI API key (required only if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the OpenAI API base URL to use an OpenAI-compatible
# endpoint (Azure OpenAI, LiteLLM/vLLM proxy, self-hosted gateway, ...).
# Leave blank/unset to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Optional: override the User-Agent header. Some third-party proxies reject the
# openai SDK's default UA ("Your request was blocked"). When OPENAI_BASE_URL is
# custom, a neutral UA (vtc/1.0) is sent automatically; set this to force a
# specific value.
# OPENAI_USER_AGENT=vtc/1.0

# Per-request timeout and explicit attempt budget. The SDK's implicit retries
# are disabled so the total wait is bounded by these values.
OPENAI_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4000

# Enforce JSON output. GLM models disable deep thinking automatically; set
# OPENAI_THINKING=enabled to opt back in on a compatible endpoint.
OPENAI_JSON_MODE=true
# OPENAI_THINKING=disabled

# Combine nearby methods into fewer prompts while preserving source line
# offsets. Set to 0 to restore one LLM request per method.
LLM_BATCH_MAX_CHARS=8000

# Endpoint producer. `llm` is the project default; `static` is a standalone
# baseline and `hybrid` is an explicitly labelled union for ablation studies.
ANALYSIS_BACKEND=llm

# targeted: analyze known security boundaries/operations (fast default)
# exhaustive: analyze every non-trivial method (best novel-API coverage)
LLM_ANALYSIS_MODE=targeted

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Applied to stderr and the persistent log. `-v` forces DEBUG for analyze/sinks.
LOG_LEVEL=INFO

# Default: $XDG_STATE_HOME/vtc/vtc.log or ~/.local/state/vtc/vtc.log.
# Set to "off" to disable persistent logging.
# LOG_FILE=~/.local/state/vtc/vtc.log

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# RNG seed for Ollama sampling — without it, quantised MoE models
# (qwen3-coder, deepseek-coder) drift between identical runs even at
# temperature=0, which makes cross-file bridge-edge matching unstable.
# Set to "none"/"off" to disable seeding (non-deterministic mode).
OLLAMA_SEED=42

# Min num_predict for Ollama (qwen3/gpt-oss prepend reasoning that consumes
# tokens before the JSON output starts).
OLLAMA_MIN_NUM_PREDICT=4096

# Set to "false" if your Ollama model returns empty content under
# grammar-constrained format="json" (observed on qwen3-coder-next:q8_0).
OLLAMA_JSON_FORMAT=true

# -----------------------------------------------------------------------------
# Graph Builder
# -----------------------------------------------------------------------------
# Use LLM-driven graph builder (tree-sitter AST + LLM enrichment)
USE_LLM_GRAPH_BUILDER=true

# Add speculative LLM-inferred graph edges after the AST pass. Disabled by
# default because it increases latency and false cross-method paths.
LLM_GRAPH_ENRICHMENT_ENABLED=false

# Min confidence for LLM-inferred edges (0.0-1.0)
LLM_GRAPH_ENRICHMENT_CONFIDENCE=0.7

# -----------------------------------------------------------------------------
# Pathfinding
# -----------------------------------------------------------------------------
# Algorithm: "astar" (with semantic heuristic) or "bfs"
PATHFINDING_ALGORITHM=astar
USE_SEMANTIC_HEURISTIC=true

# Max taint chain path length
MAX_PATH_LENGTH=15

# Min confidence threshold for sources/sinks (0.0-1.0)
MIN_CONFIDENCE=0.6

# -----------------------------------------------------------------------------
# Verification
# -----------------------------------------------------------------------------
VERIFICATION_ENABLED=true

# Level: "cfg" (fast), "symbolic" (Z3), "both"
VERIFICATION_LEVEL=both

# Timeout for symbolic execution (seconds)
SYMBOLIC_TIMEOUT=60

# -----------------------------------------------------------------------------
# Project Mode
# -----------------------------------------------------------------------------
# Max concurrent LLM requests for Stage 1 extraction
MAX_CONCURRENT_FILES=4

# Max concurrent function-level extraction requests inside one Java file.
# Keep this below the provider's account rate limit.
MAX_CONCURRENT_FUNCTIONS=2

# Max files to analyze (0 = unlimited)
MAX_FILES=0

# Debug/CI ONLY. In project mode, also drops entire files without known
# security patterns. Prefer LLM_ANALYSIS_MODE=targeted for normal fast runs,
# because targeted still keeps every file in deterministic graph analysis.
VTC_FAST_PREFILTER=false

# -----------------------------------------------------------------------------
# Optional Features
# -----------------------------------------------------------------------------
# Use Joern for PDG analysis (requires Joern installation)
USE_JOERN=true

# Download and use CodeBERT for the A* heuristic. Disabled by default because
# the deterministic heuristic is fast and does not require model downloads.
VTC_USE_CODEBERT=false
